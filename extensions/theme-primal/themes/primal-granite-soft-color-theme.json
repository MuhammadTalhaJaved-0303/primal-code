				"string.comment"
			],
			"settings": {
				"foreground": "#9E9593",
				"fontStyle": "italic"
			}
		},
		{
			"scope": [
				"string",
				"string punctuation.section.embedded source",
				"markup.inline.raw.string"
			],
			"settings": {
				"foreground": "#DFD6D4"
			}
		},
		{

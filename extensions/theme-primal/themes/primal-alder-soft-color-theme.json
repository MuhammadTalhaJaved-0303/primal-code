	"tokenColors": [
		{
			"scope": [
				"comment",
				"punctuation.definition.comment",
				"string.comment"
			],
			"settings": {
				"foreground": "#7E9D72",
				"fontStyle": "italic"
			}
		},
		{
			"scope": [
				"string",
				"string punctuation.section.embedded source",
				"markup.inline.raw.string"
			],
			"settings": {
				"foreground": "#CDEEC2"
			}
		},
		{
			"scope": [
				"constant.numeric",
				"constant.language",
				"constant.character",
				"constant.other.placeholder",
				"variable.other.enummember",
				"keyword.other.unit"
			],
			"settings": {
				"foreground": "#D1D398"
			}
		},
		{
			"scope": [
				"keyword",
				"storage",
				"storage.type",
				"storage.modifier",
				"keyword.control"
			],
			"settings": {
				"foreground": "#BCE7AC"
			}
		},
		{
			"scope": [
				"keyword.operator",
				"punctuation.separator",
				"punctuation.terminator"
			],
			"settings": {
				"foreground": "#FEFFFD"
			}
		},

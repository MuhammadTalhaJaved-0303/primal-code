			"scope": [
				"comment",
				"punctuation.definition.comment",
				"string.comment"
			],
			"settings": {
				"foreground": "#7E7160",
				"fontStyle": "italic"
			}
		},
		{
			"scope": [
				"string",
				"string punctuation.section.embedded source",
				"markup.inline.raw.string"
			],
			"settings": {
				"foreground": "#3F3325"
			}
		},
		{
			"scope": [
				"constant.numeric",
				"constant.language",
				"constant.character",
				"constant.other.placeholder",
				"variable.other.enummember",
				"keyword.other.unit"
			],
			"settings": {
				"foreground": "#504231"
			}
		},
		{
			"scope": [
				"keyword",
				"storage",
				"storage.type",
				"storage.modifier",
				"keyword.control"
			],
			"settings": {
				"foreground": "#5B4B36",
				"fontStyle": "bold"
			}
		},
		{
			"scope": [
				"keyword.operator",
				"punctuation.separator",
				"punctuation.terminator"
			],
			"settings": {
				"foreground": "#2D2A2A"
			}
		},
		{
			"scope": [
				"punctuation.definition.tag",
				"punctuation.section"
			],
			"settings": {
				"foreground": "#7E7160"
			}
		},
		{
			"scope": [
				"entity.name.function",
				"support.function",
				"meta.function-call entity.name.function",
				"meta.require"
			],
			"settings": {
				"foreground": "#372E24",
				"fontStyle": "bold"
			}
		},
		{
			"scope": [
				"entity.name.type",
				"entity.name.class",
				"entity.name.namespace",
				"entity.other.inherited-class",
				"support.class",
				"support.type"
			],
			"settings": {
				"foreground": "#372E24",
				"fontStyle": "bold"
			}
		},
		{
			"scope": [
				"entity.name.tag",
				"support.class.component"
			],
			"settings": {
				"foreground": "#5B4B36",
				"fontStyle": "bold"
			}
		},
		{
			"scope": [
				"entity.other.attribute-name",
				"meta.attribute"
			],
			"settings": {
				"foreground": "#3F3325"
			}
		},
		{
			"scope": [
				"variable",
				"meta.definition.variable",
				"variable.other"
			],
			"settings": {
				"foreground": "#2D2A2A"
			}
		},
		{
			"scope": [
				"variable.parameter"
			],
			"settings": {
				"foreground": "#2D2A2A",
				"fontStyle": "italic"
			}
		},
		{
			"scope": [
				"variable.language"
			],
			"settings": {
				"foreground": "#5B4B36",
				"fontStyle": "italic"
			}
		},
		{
			"scope": [
				"support.type.property-name",
				"meta.property-name",
				"support.variable.property"
			],
			"settings": {
				"foreground": "#372E24"
			}
		},
		{
			"scope": [
				"constant",
				"entity.name.constant",
				"variable.other.constant"
			],
			"settings": {
				"foreground": "#504231"
			}
		},
		{
			"scope": [
				"string.regexp",
				"source.regexp",
				"constant.character.escape"
			],
			"settings": {
				"foreground": "#504231"
			}
		},
		{
			"scope": [
				"markup.heading",
				"markup.heading entity.name"
			],
			"settings": {
				"foreground": "#2D2A2A",
				"fontStyle": "bold"
			}
		},
		{
			"scope": [
				"markup.bold"
			],
			"settings": {
				"foreground": "#2D2A2A",
				"fontStyle": "bold"
			}
		},
		{
			"scope": [
				"markup.italic"
			],
			"settings": {
				"foreground": "#2D2A2A",
				"fontStyle": "italic"
			}
		},
		{
			"scope": [
				"markup.underline"
			],
			"settings": {
				"fontStyle": "underline"
			}
		},
		{
			"scope": [
				"markup.strikethrough"
			],
			"settings": {
				"fontStyle": "strikethrough"
			}
		},
		{
			"scope": [
				"markup.quote"
			],
			"settings": {
				"foreground": "#7E7160",
				"fontStyle": "italic"
			}
		},
		{
			"scope": [
				"markup.inline.raw"
			],
			"settings": {
				"foreground": "#3F3325"
			}
		},
		{
			"scope": [
				"markup.underline.link",
				"string.other.link",
				"constant.other.reference.link"
			],
			"settings": {
				"foreground": "#5B4B36",
				"fontStyle": "underline"
			}
		},
		{
			"scope": [
				"markup.inserted",
				"meta.diff.header.to-file",
				"punctuation.definition.inserted"
			],
			"settings": {
				"foreground": "#3F8062"
			}
		},
		{
			"scope": [
				"markup.deleted",
				"meta.diff.header.from-file",
				"punctuation.definition.deleted"
			],
			"settings": {
				"foreground": "#671412"
			}
		},
		{
			"scope": [
				"markup.changed",
				"punctuation.definition.changed"
			],
			"settings": {
				"foreground": "#184F69"
			}
		},
		{
			"scope": [
				"meta.diff.range",
				"meta.diff.header",
				"meta.separator"
			],
			"settings": {
				"foreground": "#3F7B9B",
				"fontStyle": "bold"
			}
		},
		{
			"scope": [
				"invalid.broken",
				"invalid.deprecated",
				"invalid.illegal",
				"invalid.unimplemented",
				"message.error"
			],
			"settings": {
				"foreground": "#962925",
				"fontStyle": "italic"
			}
		},
		{
			"scope": [
				"token.info-token"
			],
			"settings": {
				"foreground": "#3F7B9B"
			}
		},
		{
			"scope": [
				"token.warn-token"
			],
			"settings": {
				"foreground": "#8B713C"
			}
		},
		{
			"scope": [
				"token.error-token"
			],
			"settings": {
				"foreground": "#962925"
			}
		},
		{
			"scope": [
				"token.debug-token"
			],
			"settings": {
				"foreground": "#674476"
			}
		}
	],
	"semanticHighlighting": true
}

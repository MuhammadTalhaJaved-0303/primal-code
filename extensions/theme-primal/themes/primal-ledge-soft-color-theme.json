		{
			"scope": [
				"comment",
				"punctuation.definition.comment",
				"string.comment"
			],
			"settings": {
				"foreground": "#94758B",
				"fontStyle": "italic"
			}
		},
		{
			"scope": [
				"string",
				"string punctuation.section.embedded source",
				"markup.inline.raw.string"
			],
			"settings": {
				"foreground": "#5C4255"
			}
		},
		{
			"scope": [

	"tokenColors": [
		{
			"scope": [
				"comment",
				"punctuation.definition.comment",
				"string.comment"
			],
			"settings": {
				"foreground": "#5D5C6A",
				"fontStyle": "italic"
			}
		},
		{
			"scope": [
				"string",
				"string punctuation.section.embedded source",
				"markup.inline.raw.string"
			],
			"settings": {
				"foreground": "#292833"
			}
		},
		{
			"scope": [
				"constant.numeric",
				"constant.language",
				"constant.character",
				"constant.other.placeholder",
				"variable.other.enummember",

				"string.comment"
			],
			"settings": {
				"foreground": "#6C535F",
				"fontStyle": "italic"
			}
		},
		{
			"scope": [
				"string",
				"string punctuation.section.embedded source",
				"markup.inline.raw.string"
			],
			"settings": {
				"foreground": "#513B46"
			}
		},
		{
			"scope": [

				"string.comment"
			],
			"settings": {
				"foreground": "#7C8482",
				"fontStyle": "italic"
			}
		},
		{
			"scope": [
				"string",
				"string punctuation.section.embedded source",
				"markup.inline.raw.string"
			],
			"settings": {
				"foreground": "#B1B9B7"
			}
		},
		{
			"scope": [

	"tokenColors": [
		{
			"scope": [
				"comment",
				"punctuation.definition.comment",
				"string.comment"
			],
			"settings": {
				"foreground": "#525A4A",
				"fontStyle": "italic"
			}
		},
		{
			"scope": [
				"string",
				"string punctuation.section.embedded source",
				"markup.inline.raw.string"
			],
			"settings": {
				"foreground": "#1D2416"
			}
		},
		{
			"scope": [
				"constant.numeric",
				"constant.language",
				"constant.character",
				"constant.other.placeholder",
				"variable.other.enummember",
				"keyword.other.unit"
			],
			"settings": {
				"foreground": "#2B3D32"
			}
		},
		{
			"scope": [
				"keyword",
				"storage",
				"storage.type",
				"storage.modifier",
				"keyword.control"
			],
			"settings": {
				"foreground": "#040200"
			}
		},
		{
			"scope": [
				"keyword.operator",
				"punctuation.separator",
				"punctuation.terminator"
			],
			"settings": {
				"foreground": "#040200"
			}
		},
		{

				"string.comment"
			],
			"settings": {
				"foreground": "#847E81",
				"fontStyle": "italic"
			}
		},
		{
			"scope": [
				"string",
				"string punctuation.section.embedded source",
				"markup.inline.raw.string"
			],
			"settings": {
				"foreground": "#4E484B"
			}
		},
		{
			"scope": [

				"string.comment"
			],
			"settings": {
				"foreground": "#797E7C",
				"fontStyle": "italic"
			}
		},
		{
			"scope": [
				"string",
				"string punctuation.section.embedded source",
				"markup.inline.raw.string"
			],
			"settings": {
				"foreground": "#9CA2A0"
			}
		},
		{
			"scope": [
